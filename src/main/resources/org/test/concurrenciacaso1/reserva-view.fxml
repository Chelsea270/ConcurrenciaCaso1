<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="448.0" prefWidth="610.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0D050E, #2B193E);"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.test.concurrenciacaso1.controller.ReservaController">
   <children>
      <Label layoutX="52.0" layoutY="14.0" text="Reserva de Entradas" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblInicio" layoutX="52.0" layoutY="32.0" text="Esperando inicio..." textFill="#F3B3C2">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Separator layoutY="46.0" prefHeight="18.0" prefWidth="610.0" style="-fx-opacity: 0.4;" />
      <Separator layoutY="84.0" prefHeight="6.0" prefWidth="610.0" style="-fx-opacity: 0.4;" />
      <VBox layoutX="50.0" layoutY="90.0" prefHeight="39.0" prefWidth="211.0">
         <children>
            <Label fx:id="lblAgente1" text="Agente 1" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente1" prefWidth="200.0" progress="0.0" style="-fx-accent: #A3445D;" />
         </children>
      </VBox>
      <VBox layoutX="47.0" layoutY="129.0" prefHeight="39.0" prefWidth="200.0">
         <children>
            <Label fx:id="lblAgente2" text="Agente 2" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente2" prefWidth="200.0" progress="0.0" style="-fx-accent: #A3445D;" />
         </children>
      </VBox>
      <VBox layoutX="50.0" layoutY="175.0" prefHeight="39.0" prefWidth="200.0">
         <children>
            <Label fx:id="lblAgente3" text="Agente 3" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente3" prefWidth="200.0" progress="0.0" style="-fx-accent: #A3445D;" />
         </children>
      </VBox>
      <TextArea fx:id="txtRegistro" layoutX="44.0" layoutY="249.0" prefHeight="129.0" prefWidth="521.0"
                style="-fx-control-inner-background: #0D050E; -fx-text-fill: #EADCE6; -fx-background-color: #8D2D56; -fx-background-radius: 6;" />
      <Button fx:id="btnIniciar" layoutX="44.0" layoutY="396.0" mnemonicParsing="false" onAction="#onIniciarRegistro"
              text="Iniciar Registro" textFill="WHITE"
              style="-fx-background-color: #D53C3C; -fx-background-radius: 8;">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Button fx:id="btnLimpiar" layoutX="156.0" layoutY="396.0" mnemonicParsing="false" onAction="#onLimpiarRegistro"
              text="Limpiar Registro" textFill="WHITE"
              style="-fx-background-color: #8D2D56; -fx-background-radius: 8;">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Label layoutX="52.0" layoutY="231.0" text="Registro de las entradas" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label fx:id="lblDisponibles" layoutX="156.0" layoutY="61.0" text="Disponibles" textFill="#F3B3C2">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblConfirmadas" layoutX="270.0" layoutY="61.0" text="Confirmadas:" textFill="#E8798F">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Label>
      <Label fx:id="lblRechazadas" layoutX="399.0" layoutY="61.0" text="Rechazadas" textFill="#D53C3C">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Label>
   </children>
</AnchorPane>