<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="448.0" prefWidth="610.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.test.concurrenciacaso1.controller.ReservaController">
   <children>
      <Label layoutX="52.0" layoutY="14.0" text="Reserva de Entradas">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblInicio" layoutX="52.0" layoutY="32.0" text="Esperando inicio...">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Separator layoutY="46.0" prefHeight="18.0" prefWidth="610.0" />
      <Separator layoutY="84.0" prefHeight="6.0" prefWidth="610.0" />
      <VBox layoutX="50.0" layoutY="90.0" prefHeight="39.0" prefWidth="211.0">
         <children>
            <Label fx:id="lblAgente1" text="Agente 1">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente1" prefWidth="200.0" progress="0.0" />
         </children>
      </VBox>
      <VBox layoutX="47.0" layoutY="129.0" prefHeight="39.0" prefWidth="200.0">
         <children>
            <Label fx:id="lblAgente2" text="Agente 2">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente2" prefWidth="200.0" progress="0.0" />
         </children>
      </VBox>
      <VBox layoutX="50.0" layoutY="175.0" prefHeight="39.0" prefWidth="200.0">
         <children>
            <Label fx:id="lblAgente3" text="Agente 3">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <ProgressBar fx:id="pbAgente3" prefWidth="200.0" progress="0.0" />
         </children>
      </VBox>
      <TextArea fx:id="txtRegistro" layoutX="44.0" layoutY="249.0" prefHeight="129.0" prefWidth="521.0" />
      <Button fx:id="btnIniciar" layoutX="44.0" layoutY="396.0" mnemonicParsing="false" onAction="#onIniciarRegistro" text="Iniciar Registro">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Button fx:id="btnLimpiar" layoutX="156.0" layoutY="396.0" mnemonicParsing="false" onAction="#onLimpiarRegistro" text="Limpiar Registro">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Label layoutX="52.0" layoutY="231.0" text="Registro de las entradas">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label fx:id="lblDisponibles" layoutX="156.0" layoutY="61.0" text="Disponibles">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblConfirmadas" layoutX="270.0" layoutY="61.0" text="Confirmadas:">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Label>
      <Label fx:id="lblRechazadas" layoutX="399.0" layoutY="61.0" text="Rechazadas">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Label>
   </children>
</AnchorPane>
